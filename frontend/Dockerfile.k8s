# Build estatico separado do Dockerfile usado pelo Docker Compose.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --loglevel verbose
COPY . .
# Alterna exclusivamente a demo de classificacao para fixture local no navegador.
ENV VITE_DEMO_OFFLINE=true
RUN npm run build

# Imagem sem privilegios, porta >1024, para servir somente a UI compilada.
FROM nginxinc/nginx-unprivileged:stable-alpine
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY nginx.k8s.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
